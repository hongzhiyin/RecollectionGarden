{
  "name": "recollection-garden",
  "version": "0.6.4",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "bridge": "node bin/recollection-garden.mjs serve",
    "cli": "node bin/recollection-garden.mjs",
    "mcp": "node bridge/mcp.mjs",
    "package:mac": "npm run build && node scripts/package-macos.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "check": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "package:windows": "npm run build && node scripts/package-windows.mjs"
  },
  "bin": {
    "recollection-garden": "bin/recollection-garden.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "dexie": "4.4.6",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "6.2.5",
    "pdf-lib": "1.17.1",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
